# Metadata/search backend: self-hosted Supabase on OCI, exposed publicly via Tailscale Funnel.
# schema: rat (via mobile_catalog_view + a few lookup tables, anon role is read-only/scoped to these)
VITE_SUPABASE_URL=https://huey.taila2eeb2.ts.net
VITE_SUPABASE_ANON_KEY=

# Images: same oci instance's Storage now (migrated from a separate old cloud project 2026-09-06,
# see filemaker_sync/devlog/worksheet.md Session 15) — no key needed, plain public GET.
VITE_IMAGES_BASE_URL=https://huey.taila2eeb2.ts.net/storage/v1/object/public/picaloco/images

# --- Server-only (api/agent-auth.ts) — picaloco_agent's activation gate ---
# These do NOT get the VITE_ prefix on purpose: that prefix means Vite inlines the value into the
# client bundle, and both of these must never reach a browser. Set as real secrets in Vercel's
# Project Settings → Environment Variables, never in a committed .env file (this one's just a
# documentation template — leave these blank/unset locally, `vercel dev` reads the real values from
# Vercel's own env var store).
SUPABASE_SERVICE_ROLE_KEY=
AGENT_DB_PASSWORD=
